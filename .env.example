# Configuración del Entorno - SysHSENA Hotel W
# Copia este archivo como .env para desarrollo local:
#   cp .env.example .env

# Modo depuración (True para desarrollo local, False para producción)
DEBUG=True

# Clave secreta de Django (en producción usar un valor largo y aleatorio)
SECRET_KEY=dev-secret-key-change-in-production-hotelw-syshsena

# Hosts permitidos separados por comas
ALLOWED_HOSTS=127.0.0.1,localhost

# Base de datos:
# Para desarrollo local con SQLite:
DATABASE_URL=sqlite:///db.sqlite3
# Para MySQL / TiDB Cloud en producción:
# DATABASE_URL=mysql://<usuario>:<contraseña>@<host>:4000/<nombre_bd>?ssl_mode=VERIFY_IDENTITY
